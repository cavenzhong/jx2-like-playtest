  "revealContent": [
    {
      "trigger": {"pointId": "chenliu", "probeAtLeast": 1},
      "reveal": ["yezhulin"],
      "mapText": "林口有新砍的车辙，泥里混着血。",
      "noteText": "有人先于你进入林中。"
    },
    {
      "trigger": {"pointId": "yezhulin", "probeAtLeast": 1},
      "reveal": ["pomiao"],
      "mapText": "荒庙的香灰是冷的，灯芯却刚换过。",
      "noteText": "黑色印泥不属于普通镖局。"
    },
    {
      "trigger": {"pointId": "chenliu", "probeAtLeast": 2},
      "reveal": ["zhuxian"],
      "mapText": "商路向南折去，河风里有火油味。",
      "noteText": "运图队曾在朱仙镇改道。"
    },
    {
      "trigger": {"pointId": "zhuxian", "probeAtLeast": 1},
      "reveal": ["hedu"],
      "mapText": "渡船只剩半条缆，水面漂着断箭。",
      "noteText": "有人从水路把货送向东边。"
    },
    {
      "trigger": {"pointId": "chenliu", "probeAtLeast": 3},
      "reveal": ["heifengzhai"],
      "mapText": "无旗的寨门后，挂着倒写的黑字。",
      "noteText": "马贼只是门，门后还有人。"
    },
    {
      "trigger": {"itemId": "bounty_post_east_bandits", "runSuccess": true},
      "reveal": ["heifengzhai"],
      "mapText": "悬赏帖上的朱砂印与寨门黑字重合。",
      "noteText": "目标确认：黑风寨。"
    }
  ],
